{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dorisa-consult",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dorisaconsult.com",
      "custom_domain": true
    },
    {
      "pattern": "www.dorisaconsult.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  }
}
